Windows Registry Editor Version 5.00

; ============================================================
; GAMING CPU OPTIMIZATION - SAFE REGISTRY SETTINGS
; Windows 10/11 - Intel CPU
; ============================================================
; NOTE:
; - This file does NOT overclock the CPU.
; - Intel Turbo Boost remains controlled by BIOS/firmware.
; - Core Parking controls are exposed so Windows power-plan
;   settings can be configured. A .reg file alone cannot
;   reliably change the active power plan on every PC.
; - Restart Windows after importing.
; ============================================================


; ------------------------------------------------------------
; 1. Expose CPU Core Parking settings
; ------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\54533251-82be-4824-96c1-47b60b740d00\0cc5b647-c1df-4637-891a-dec35c318583]
"Attributes"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\54533251-82be-4824-96c1-47b60b740d00\ea062031-0e34-4ff1-9b6d-eb1059334028]
"Attributes"=dword:00000000


; ------------------------------------------------------------
; 2. Foreground application scheduling
; ------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\PriorityControl]
"Win32PrioritySeparation"=dword:00000026


; ------------------------------------------------------------
; 3. Hardware Accelerated GPU Scheduling
; ------------------------------------------------------------
; Windows will ignore this if unsupported.

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\GraphicsDrivers]
"HwSchMode"=dword:00000002


; ------------------------------------------------------------
; 4. Disable Dynamic Tick
; ------------------------------------------------------------
; Can reduce timer-related variability on some systems.
; It is not an FPS guarantee.

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\kernel]
"DisableDynamicTick"=dword:00000001
